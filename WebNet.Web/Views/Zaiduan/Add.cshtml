@model WebNet.Model.Zaiduan
@{
    ViewBag.Title = Model.Id == 0 ? "新增Zaiduan" : "编辑Zaiduan";
    Layout = "_Layout";
}
<div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
    <ul class="layui-tab-title">
        <li class="layui-this">@ViewBag.Title</li>
    </ul>
</div>
<form class="layui-form" action="">

    <div class='layui-form'>
        <div class='layui-form-item'>
            <label class='layui-form-label'>值班领导</label>
            <div class='layui-input-block'>
                @Html.TextBoxFor(a => a.Name, new { @class = "layui-input", lay_verify = "required" })
            </div>
            <div class='layui-form-mid layui-word-aux'><!--辅助文字--></div>
        </div>
        <div class='layui-form-item'>
            <label class='layui-form-label'>值班主管</label>
            <div class='layui-input-block'>
                @Html.TextBoxFor(a => a.Number, new { @class = "layui-input", lay_verify = "required" })
            </div>
            <div class='layui-form-mid layui-word-aux'><!--辅助文字--></div>
        </div>
        <div class='layui-form-item'>
            <label class='layui-form-label'>值班日期</label>
            <div class='layui-input-block'>
                @Html.TextBoxFor(a => a.Area, new { @class = "layui-input", lay_verify = "required" })
            </div>
            <div class='layui-form-mid layui-word-aux'><!--辅助文字--></div>
        </div>



        <div class="layui-form-item">
            <label class='layui-form-label'>&nbsp;</label>
            <div class="layui-input-inline">
                <button id="btn1" class="layui-btn" lay-submit="" lay-filter="demo1">@ViewBag.Title</button>
                @Html.AntiForgeryToken()
                @Html.HiddenFor(a => a.Id)
            </div>
            <div class="layui-input-inline">
                <button class="layui-btn layui-btn-primary" type="button" onclick="history.go(-1)">返回</button>
            </div>
        </div>
    </div>

</form>

<script>

    var pop_index;
        var editor1;

            /*加载layui编辑器*/
            layui.use(['form',  'layer','laydate','upload'], function () {
                var form = layui.form;
    var laydate = layui.laydate;
      var upload = layui.upload;
      var layer = layui.layer;
      var $ = layui.jquery;


     var uploadInst = upload.render({
                    elem:'#btnimg',
                    url: '/Home/ImgUpload' //上传接口
                    , done: function (res) { //上传成功后的回调
                       // console.log(res);
                        document.getElementById("img1").src = res.data.src;
                        document.getElementById("img").value = res.data.src;    //这里的img对应表中的字段，有可能是face也有可能是logo
                    }
                });



                //监听提交
                form.on('submit(demo1)', function (data) {
                    var url = "/Zaiduan/add";
                    var postdata = data.field;
                    //postdata.body = editor1.html();
    //postdata.body = editor.txt.html();

            $('#btn1').attr("class", "layui-btn layui-btn-disabled");
                $('#btn1').attr("disabled", "disabled");

                    pop_index = layer.load(0, {
                    shade: [0.3, '#000'] //0.1透明度的白色背景
                });
                    $.post(url, postdata, function (data) {
    layer.close(pop_index);
                        if (data.code == 0) {
                            layer.msg(data.msg, function () { location.href = "/Zaiduan/";})
                        } else {
                            layer.alert(data.msg);
    $('#btn1').attr("class", "layui-btn");
                $('#btn1').removeAttr("disabled");
                        }
                    }, 'json')
                    return false;
                });

            });
</script>
