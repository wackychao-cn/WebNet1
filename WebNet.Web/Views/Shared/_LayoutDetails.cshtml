<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 电气设备分公司信息平台</title>
     <link rel="icon" type="image/x-icon" href="/favicon.png">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" asp-append-version="true" />
    <link href="~/layui/css/layui.css" rel="stylesheet" />
    <script src="~/layui/layui.js"></script>
    <style type="text/css">

        body {
            margin: 0px;
            padding: 0px;
            background-color: #F4F2F5;
        }





        .one:link {
            color: #FFF;
            text-decoration: none;
        }



        .one:visited {
            color: #FFF;
            text-decoration: none;
        }



        .one:hover {
            text-decoration: none;
            color: #9C3;
            font-size: 16px;
            font-weight: bold;
        }



        .two:link {
            color: #000;
            text-decoration: none;
            text-align: center;
        }



        .two:visited {
            color: #000;
            text-decoration: none;
        }



        .tzgg_1 {
            font-family: "微软雅黑", "宋体";
            font-size: 24px;
        }



        .two:hover {
            text-decoration: none;
            color: #9C3;
            font-size: 16px;
            font-weight: bold;
        }



        .table_top {
            margin-top: 10px;
        }



        .table_bgcolor {
            background-color: #FFF;
            color: #FFF;
        }



        .Link_cf {
            font-family: "微软雅黑", "宋体";
            font-size: 14px;
            color: #000;
            text-decoration: none;
            font-weight: normal;
        }



        a {
            color: #000;
            text-decoration: none;
        }



        .a_bt {
            font-family: "微软雅黑", "宋体";
            font-weight: bold;
            color: #FFF;
            text-align: center;
            background-color: #C9202D;
        }

        .a_btc {
            font-family: "微软雅黑", "宋体";
            font-weight: bold;
            font-size:20px;
            color: #FFF;
            text-align: center;
            background-color: #343434;
        }

        
        img {
            margin: 0px;
            padding: 0px;
            border-top-width: 0px;
            border-right-width: 0px;
            border-bottom-width: 0px;
            border-left-width: 0px;
        }



        a:link {
            text-decoration: none;
        }



        a:visited {
            text-decoration: none;
        }



        a:hover {
            text-decoration: none;
        }



        a:active {
            text-decoration: none;
        }
        /* 下拉菜单容器 */
        .dropdown {
            position: relative;
            display: inline-block;
        }

        /* 下拉菜单内容（默认隐藏） */
        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #f9f9f9;
            min-width: 160px;
            box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
            z-index: 1;
        }

            /* 下拉菜单中的链接 */
            .dropdown-content a {
                font-size: 14px; /* 修改字体大小 */
                color: black;
                padding: 4px 8px; /* 修改单元格高度 */
                text-decoration: none;
                display: block;
            }

        /* 鼠标悬停时显示下拉菜单 */
        .dropdown:hover .dropdown-content {
            display: block;
        }

        /* 鼠标悬停时改变下拉菜单链接的背景颜色 */
        .dropdown-content a:hover {
            background-color: #f1f1f1;
        }

        main {
            padding-bottom: 80px; /* 根据 footer 的高度调整 */
        }

    </style>
</head>

<body>

