@using System.Data
@using WebNet.DAL
@{
    List<WebNet.Model.Category> top = new WebNet.DAL.CategoryDAL().GetTopList(12, "[Pbh] like '0'");
    string imp=new WebNet.DAL.CategoryDAL().GetModelByCond("[Caname] like '重点工作'").Bh;
    List<WebNet.Model.Category> importwork = new WebNet.DAL.CategoryDAL().GetTopList(3, "[Pbh] like '"+imp+"'");
    List<string> lanmu=new List<string>();
    foreach (var item in top)
    {
        lanmu.Add(item.Caname);
    }
    Layout = null;
}




