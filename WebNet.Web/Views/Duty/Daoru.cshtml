@{
}
<a  href="/upload/duty/template.csv" >导入模板下载</a>
<div>
    
    <br />
    <br />
    <form id="uploadForm">
        按照模板按月上传单个csv文件： <input type="file" name="file"  />
        <input type="button" value="上传" onclick="doUpload()" />
    </form>
</div>
<script>
    function doUpload() {
            var formData = new FormData($("#uploadForm")[0]);
            $.ajax({
                url: '@Url.Action("FileSave")',
                type: 'POST',
                data: formData,
                async: false,
                cache: false,
                contentType: false,
                processData: false,
                success: function (returndata) {
                    alert("上传完成");
                    window.history.go(-1);
                },
                error: function (returndata) {
                    alert("上传失败");
                    window.history.go(-1);
                }
            });
            }
            </script>