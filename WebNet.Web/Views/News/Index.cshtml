@using System.Data
@using WebNet.DAL
@{
    ViewBag.Title = "News";
     Layout="_Layout";
  
}
 <style>
     .layui-form select{
        display:block;
        border:1px solid #d2d2d2;
        height:38px;
    }
</style>

<div class="layui-tab layui-tab-brief" lay-filter="docDemoTabBrief">
  <ul class="layui-tab-title">
        <li class="layui-this">数据管理</li>
  </ul> 
</div>      
<div style="padding:10px;">
    <div id="box" hidden="hidden"></div>
    <div class="layui-form">
<a class="layui-btn layui-btn-primary" href="javascript:location.reload();">
            <i class="layui-icon">&#xe669;</i> 刷新
        </a>
        <a class="layui-btn"  onclick="train()">
            <i class="layui-icon">&#xe608;</i> 添加
        </a>
        <a class="layui-btn" onclick="batchAdd()">
            <i class="layui-icon">&#xe608;</i> 文件批量添加
        </a>
        <div class="layui-input-inline">
            <input type="text" id="search_key"  name="ser" class="layui-input" placeholder="搜索关键字" />
        </div>
        <div class="layui-input-inline">
            发布时间：
        </div>
        <div class="layui-input-inline">
            <input type="text" id="search_start" class="layui-input" placeholder="开始时间" autocomplete="off" />
        </div>
        <div class="layui-input-inline">
            ~
        </div>
        <div class="layui-input-inline">
            <input type="text" id="search_end" class="layui-input" placeholder="结束时间" autocomplete="off" /> 
        </div>
        <div class="layui-input-inline">
            <select id="search_cabh" lay-ignore>
                <option value="Caname">--板块名称--</option>
                <option value="Title">--标题--</option>
                <option value="Body">--正文--</option>
            </select>
        </div>
        <div class="layui-input-inline">
            <button class="layui-btn layui-btn-normal" type="button" onclick="search()"><i class="layui-icon">&#xe615;</i> 查询</button>
        </div>
        @Html.Hidden("order","Id")
            @Html.Hidden("ordertype","desc")
    </div>
    <table class="layui-table" lay-size="sm">
        <thead>
            <tr>
             <th>管理</th>
                <th>主键
<span class="layui-icon layui-icon-up" title="Id asc"></span> 
<span class="layui-icon layui-icon-down" title="Id desc"></span> 
</th> 
<th>创建时间
<span class="layui-icon layui-icon-up" title="CreateTime asc"></span> 
<span class="layui-icon layui-icon-down" title="CreateTime desc"></span> 
</th>
<th>上传者
<span class="layui-icon layui-icon-up" title="Creater asc"></span>
<span class="layui-icon layui-icon-down" title="Creater desc"></span>
</th>
<th>分类名称
<span class="layui-icon layui-icon-up" title="Caname asc"></span> 
<span class="layui-icon layui-icon-down" title="Caname desc"></span> 
</th> 
<th>标题
<span class="layui-icon layui-icon-up" title="Title asc"></span> 
<span class="layui-icon layui-icon-down" title="Title desc"></span> 
</th> 
<th>正文
<span class="layui-icon layui-icon-up" title="Body asc"></span> 
<span class="layui-icon layui-icon-down" title="Body desc"></span> 
</th> 

               
            </tr>
        </thead>
        <tbody id="tbody"> 
        </tbody>
    </table>
    <div>
        <div style="float: left; line-height: 55px;margin: 0 15px; font-size: 16px;">
            当前共<span id="totalcount"></span>条记录，每页<span id="pagesize"></span>条，第<span id="pageindex"></span>页/共<span id="pagecount"></span>页
        </div>
        <div id="pages">

        </div>
    </div>
</div>
<style>
    .layui-icon{
        color:#dcdcdc;
    }
    .layui-icon-active{
        color:black;
    }
</style>
<script>
                     function   train(){
                             var uurl="/News/Add?"+"txt="+encodeURI(moren);
                                    window.open(uurl, "_blank");
              }
                    var loc = location.href;
                var n1 = loc.length;
                var txt;
                            let n2 = loc.indexOf('=');
        if (n2 === -1) {
                 txt = null;
    }
        else
            {
                 txt = decodeURI(loc.slice(n2+1,n1));
            }
                    var box = document.getElementById('box');
                box.innerHTML = txt;
            var pop_index;
                var pagesize = 10; //页大小
                 search();
             var moren=txt;

           document.getElementById('search_key').value= moren;

    /*日期选择控件设置*/
    layui.use('laydate', function () {
        var laydate = layui.laydate;
        laydate.render({
            elem: '#search_start' //指定元素
        });
        laydate.render({
            elem: '#search_end' //指定元素
        }); 
    });
        var $ = layui.jquery;
   //排序图标点击
    $(".layui-table .layui-icon").click(function () {
        $('.layui-icon-active').removeClass("layui-icon-active");
        $(this).addClass("layui-icon-active");
        var title = $(this).attr('title');
        var order = title.split(' ')[0];
        var ordertype = title.split(' ')[1];
        $('#order').val(order);
        $('#ordertype').val(ordertype);
        search();
    })
    //获取left页面的数据



		  
    /*加载第X页数据*/
    function load_blog_data(pageindex) {
      //  console.log("加载第" + pageindex + "页");


        layui.use('layer', function () {
            var $ = layui.jquery, layer = layui.layer;

            $('#pageindex').text(pageindex);

 
            var postdata = getcond();

            var url = "/News/List?pageindex=" + pageindex + "&pagesize=" + pagesize;
            pop_index = layer.load(0, {
                shade: [0.3, '#000'] //0.1透明度的白色背景
            }); 
            $.post(url,postdata, function (json) {
layer.close(pop_index);
                var html = '';
                $.each(json, function (i, item) {
                   // console.log("第" + i + "个元素：");
                  //  console.log(blog);
                    html += '<tr>'; 
                            html += '    <td>';
                    html += '        <a href="/News/Add/' + item.Id + '" target="_blank"><i class="layui-icon">&#xe642;</i> 编辑</a>';
                    html += '        <a href="javascript:void(0);" onclick="del(' + item.Id + ')"><i class="layui-icon">&#x1006;</i> 删除</a>';
                    html += '    </td>';
					html += '    <td>' + item.Id + '</td>'; 
html += '    <td>' + item.CreateTime + '</td>';
    html += '    <td>' + item.Creater + '</td>';
    html += '    <td>' + item.Caname + '</td>';
        moren = item.Caname;
// html += '    <td>' + item.Bh + '</td>'; 
html += '    <td>' + item.Title + '</td>'; 
// html += '    <td>' + item.Body + '</td>';
    html += '    <td>略</td>';

                        html += '</tr>';

                })

                $('#tbody').html(html);

            }, 'json');
        })


    }

    /*拼接条件返回postdata*/
    function getcond() {

        var key = document.getElementById("search_key").value;
        var start = document.getElementById('search_start').value;
        var end = document.getElementById('search_end').value;
        var cabh = document.getElementById('search_cabh').value;
         var order = $('#order').val();
        var ordertype = $('#ordertype').val();
        var postdata = { key: key, start: start, end: end, cabh: cabh, order: order, ordertype: ordertype };
        return postdata;
    }

    /*查询*/
    function search() {

        layui.use(['laypage', 'layer'], function () {
            var laypage = layui.laypage, layer = layui.layer, $ = layui.jquery;

            var postdata = getcond();

            var url = "/News/GetTotalCount?t=" + new Date().valueOf();
            $.post(url,postdata, function (count) {

                var pagecount = (count % pagesize == 0 ? count / pagesize : Math.ceil(count / pagesize)); //总页数
               // console.log("总记录数：" + count + "，总页数：" + pagecount);
                $('#totalcount').text(count);
                $('#pagecount').text(pagecount);
                    $('#pagesize').text(pagesize);
                laypage.render({
                    elem: 'pages',
                    count: count, //得到总页数
	    limit: pagesize,
                    jump: function (obj) {
                        var pageindex = obj.curr;
                        //layer.alert("点击了第" + pageindex + "页。");
                        //读取后台数据数据返回JSON后拼接HTML
                        load_blog_data(pageindex);
                    }
                });

            });

        });

    }


    /*删除*/
    function del(id) {
        layui.use('layer', function () {
            var layer = layui.layer;
            var $ = layui.jquery;

            layer.confirm('是否确认删除？', function () {

                var url = "/News/Delete?ids=" + id;
                pop_index = layer.load(0, {
                shade: [0.3, '#000'] //0.1透明度的白色背景
            }); 
                $.post(url, function (data) {
                layer.close(pop_index);
                    if (data.code == 0) {
                        layer.msg(data.msg, function () { location.reload(); });
                    } else {
                        layer.msg(data.msg);
                    }
                })

            })



        })


    }
       function batchAdd() {
        layui.use(['upload', 'layer', 'element', 'jquery'], function () {
            var upload = layui.upload;
            var layer = layui.layer;
            var element = layui.element;
            var $ = layui.jquery;

            var totalFiles = 0; // 文件总数
            var uploadedFiles = 0; // 已上传文件数
            var progressInterval; // 定时器

            var uploadIndex = layer.open({
                type: 1,
                title: '批量上传PDF文件',
                content: '<div class="layui-upload">' +
                    '<button type="button" class="layui-btn" id="uploadBtn">选择文件</button>' +
                    '<span style="margin-left: 10px;">只能上传PDF文件，单个文件不超过20MB</span>' +
                    '<div style="margin-top: 10px;">' +
                    '<span>文件总数: <span id="totalFiles">0</span></span>' +
                    '<span style="margin-left: 20px;">已上传: <span id="uploadedFiles">0</span></span>' +
                    '</div>' +
                    '<div class="layui-progress layui-progress-big" lay-filter="uploadProgress" style="margin-top: 10px;">' +
                    '<div class="layui-progress-bar" lay-percent="0%"></div>' +
                    '</div>' +
                    '</div>',
                area: ['500px', '250px'],
                btn: ['确定', '取消'],
                yes: function (index, layero) {
                    // 点击确定按钮时触发上传
                    uploadList.upload();
                    layer.close(index);
                },
                btn2: function (index, layero) {
                    // 点击取消按钮时关闭弹层
                    layer.close(index);
                }
            });

            // 初始化上传组件
            var uploadList = upload.render({
                elem: '#uploadBtn',
                url: '/News/FileSave', // 上传文件的接口
                accept: 'file',
                exts: 'pdf', // 只允许上传PDF文件
                size: 20 * 1024, // 限制文件大小为20MB
                multiple: true, // 允许多文件上传
                data: {
                    search_key: function () {
                        return $('#search_key').val(); // 获取 search_key 的值
                    }
                },
                before: function (obj) {
                    // 使用 obj.pushFile() 获取文件列表
                    var files = obj.pushFile();
                    totalFiles = files.length;
                    $('#totalFiles').text(totalFiles);
                    $('#uploadedFiles').text(0);
                    layer.msg('开始上传...', { icon: 16, time: 100 });

                    // 启动定时器，定期获取进度
                    progressInterval = setInterval(function () {
                        $.ajax({
                            url: '/News/GetUploadProgress',
                            type: 'GET',
                            success: function (res) {
                                if (res.code === 0) {
                                    var percent = Math.round((res.uploadedFiles / totalFiles) * 100) + '%';
                                    element.progress('uploadProgress', percent);
                                    $('#uploadedFiles').text(res.uploadedFiles);
                                }
                            }
                        });
                    }, 100); // 每0.1秒获取一次进度
                },
                    allDone: function (res) {
        // 所有文件上传完成
        clearInterval(progressInterval); // 停止定时器
        layer.msg('所有文件上传完成', { icon: 1 });
        layer.open({
            type: 1,
            title: '上传完成',
            content: '<div style="padding: 20px;">已上传文件总数: ' + uploadedFiles + '</div>',
            area: ['300px', '150px'],
            btn: ['确定'],
            yes: function (index, layero) {
                layer.close(index);
                layer.close(uploadIndex); // 关闭上传弹出层
                location.reload(); // 刷新页面
            }
        });
    },
                done: function (res) {
                    // 单个文件上传成功
                    uploadedFiles++;
                    $('#uploadedFiles').text(uploadedFiles);
                    if (res.code === 0) {
                        layer.msg('上传成功', { icon: 1 });
                    } else {
                        layer.msg(res.msg, { icon: 2 });
                    }
                },
                error: function () {
                    clearInterval(progressInterval); // 停止定时器
                    layer.msg('上传失败', { icon: 2 });
                }
            });

            // 初始化进度条
            element.render('progress');
        });
    }



</script>
