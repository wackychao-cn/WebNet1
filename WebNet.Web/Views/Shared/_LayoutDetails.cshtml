        </table>
    </header>
            @RenderBody()

    <footer class="border-top footer text-muted" style="position: fixed; bottom: 0; width: 100%; background-color: #343434; z-index: 1000;">
        <table width="1400" border="0" align="center" cellpadding="0" cellspacing="0">


            <tr>

                <td height="67" colspan="6" bgcolor="#343434"><img src="~/pic/image (38).png" alt="1" width="1400" height="67" /></td>

            </tr>

