@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@using WebNet.DAL
@using WebNet.Web.Models
@model BackModels

@{

    Layout = "_LayoutDetails";
}



<head>

    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />

    <title>公告</title>

    <style type="text/css">

        .body {
        background: #F0F0F0;
        text-align: center;
        margin: 0px;
        padding: 0px;
        }

        .img {
        margin: 0px;
        padding: 0px;
        border-top-width: 0px;
        border-right-width: 0px;
        border-bottom-width: 0px;
        border-left-width: 0px;
        }

        .content_pb {
        font-family: "宋体";
        font-size: 14px;
        color: #000;
        letter-spacing: normal;
        text-align: center;
        text-indent: 0.1cm;
        word-spacing: normal;
        white-space: pre;
        }

        .a_bt {
        font-family: "微软雅黑", "宋体";
        font-weight: bold;
        color: #FFF;
        text-align: center;
        background-color: #C9202D;
        }

        a:link {
        text-decoration: none;
        }

        a:visited {
        text-decoration: none;
        }

        a:hover {
        text-decoration: none;
        color: #FF3;
        }

        a:active {
        text-decoration: none;
        }
    </style>
</head>
<body>

    <table width="1400" border="0" align="center" cellpadding="0" cellspacing="0" align-items="center"  style="margin: auto; margin-bottom: 68px;">

        <tr>

            <td width="1400">
                <table width="100%" border="0" cellspacing="0" cellpadding="0" align="center">
                    <tr>

                        <td align="center">
                            <table width="1400" border="0" align="center" cellpadding="0" cellspacing="0">

                                <tr>

                                    <td width="100" rowspan="2">&nbsp;</td>

                                    <td width="1200" height="100">
                                        <table width="1200" border="0" cellspacing="0" cellpadding="0">

                                            <tr>
                                                <td height="40" valign="bottom"><a href="*" target="_blank">首页&gt;</a>&gt;<a href="*" target="_new"></a></td>

                                            </tr>

                                            <tr>

                                                <td height="10"><hr /></td>

                                            </tr>

                                            <tr>

                                                <td height="40">
                                                    <table width="1200" border="0" cellspacing="0" cellpadding="0">

                                                        <tr>

                                                            <td height="30"><h1 align="center">@ViewBag.Title</h1></td>

                                                        </tr>

                                                        <tr>

                                                            <td height="10">
                                                                <table width="1200" border="0" cellspacing="0" cellpadding="0">

                                                                    <tr>

                                                                        <td width="439">&nbsp;</td>

                                                                        <td style="width:180px;">作者：电气设备分公司</td>

                                                                        <td style="width:280px;">
                                                                            @{
                                                                                string con = "发布日期：" + DateTime.Now.ToShortDateString();

                                                                            }@con
                                                                        </td>

                                                                        <td width="379">&nbsp;</td>

                                                                    </tr>

                                                                </table>
                                                            </td>

                                                        </tr>

                                                    </table>
                                                </td>

                                            </tr>

                                        </table>
                                    </td>

                                    <td width="100" rowspan="2">&nbsp;</td>

                                </tr>

                                <tr>

                                    <td style="max-width: 1200px">
                                        @Html.Raw(ViewBag.Body)
                                    </td>
                                </tr>
                            </table>
                        </td>

                    </tr>

                </table>
            </td>

        </tr>

    </table>

</body>
@if (ViewBag.AbsoluteUrl != null)
{
    <script type="text/javascript">
        // 在新窗口中打开链接
        window.open('@ViewBag.AbsoluteUrl', '_blank');
    </script>
}
