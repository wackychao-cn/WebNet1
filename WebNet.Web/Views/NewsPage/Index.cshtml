<div id="box" hidden="hidden"></div>
<div width="1200"  style="text-align: center">

    <iframe src=Left  name="leftFrame" id="leftFrame" title="leftFrame" width="230" height="900"></iframe>

    <iframe src="/News/Front" name="mainFrame" id="mainFrame" title="mainFrame" width="1050" height="900"></iframe>
</div>

<script>
                    var loc = location.href;
                    var n1 = loc.length;
                    var txt;
                                let n2 = loc.indexOf('=');
            if (n2 === -1) {
                     txt = null;
        }
            else
                {
                     txt = decodeURI(loc.slice(n2+1,n1));
                }
                        var box = document.getElementById('box');
                    box.innerHTML = txt;
        mainFrame.location.href="/News/Front?"+"txt="+encodeURI(txt);

</script>