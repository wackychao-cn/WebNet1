@using System.Data
@using WebNet.DAL
@{
    ViewBag.Title = "News";
    Layout = null;

}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" asp-append-version="true" />
<link rel="stylesheet" type="text/css" href="~/layui/css/layui.css" />
<script src="~/layui/layui.js"></script>
<style>
    body {
        margin: 0px;
        padding: 0px;
        background-color: #F0F0F0;
    }
    .layui-form select {
        display: block;
        border: 1px solid #d2d2d2;
        height: 38px;

    }


</style>

<div style="padding:10px;" >
    <div id="box" hidden="hidden"></div>
    <div class="layui-form">
            
        @Html.Hidden("order", "Id")
        @Html.Hidden("ordertype", "desc")
    </div>
    <br />
    <br />
        <table width="970" border="0" cellspacing="0" cellpadding="0">



            <tr>

                <td width="70" height="30">&nbsp;</td>

                <td valign="bottom"><strong class="tzgg_1">导航</strong></td>

                <td width="130" valign="bottom">您现在的位置是：</td>

            <td width="35" valign="bottom"><a href="/Home/Index" target="_parent">首页</a></td>

                <td width="15" align="center" valign="bottom">-</td>

            <td width="200" align="left" valign="bottom"><label id="space">导航栏</label></td>

            </tr>

        </table>

        <hr align="right" width=100% size="1" class="new1"/>

        <div align="center">



        <table width="970" border="0" cellspacing="0" cellpadding="0" style="table-layout:fixed;">
            <tbody id="tbody">
            </tbody>
            
            </table>
            </div>

    <div>
        <div style="text-align:center; line-height: 55px;margin: 0 15px; font-size: 16px;" >
            当前共<span id="totalcount"></span>条记录，每页<span id="pagesize"></span>条，第<span id="pageindex"></span>页/共<span id="pagecount"></span>页
        </div>
        <div id="pages">
        </div>
    </div>
</div>

<style>
    .layui-icon {
        color: #dcdcdc;
    }

    .layui-icon-active {
        color: black;
    }

    hr.new5 {
        border: 1px solid gray;
    }

    hr.new1 {
        border: 1px solid gray;
    }
</style>
<script>
                    var pop_index;
                    var pagesize = 10; //页大小
                    var loc = location.href;
                    var n1 = loc.length;
                    var txt;
                                let n2 = loc.indexOf('=');
            if (n2 === -1) {
                     txt = null;
        }
            else
                {
                     txt = decodeURI(loc.slice(n2+1,n1));
                }
                        var box = document.getElementById('box');
                    box.innerHTML = txt;
               document.getElementById('box').value= txt; 
               search();
        /*日期选择控件设置*/
        layui.use('laydate', function () {
            var laydate = layui.laydate;
            laydate.render({
                elem: '#search_start' //指定元素
            });
            laydate.render({
                elem: '#search_end' //指定元素
            });
        });





        /*加载第X页数据*/
        function load_blog_data(pageindex) {
          //  console.log("加载第" + pageindex + "页");


            layui.use('layer', function () {
                var $ = layui.jquery, layer = layui.layer;

                $('#pageindex').text(pageindex);


                var postdata = getcond();

                var url = "/News/List?pageindex=" + pageindex + "&pagesize=" + pagesize;
                pop_index = layer.load(0, {
                    shade: [0.3, '#000'] //0.1透明度的白色背景
                });
                $.post(url,postdata, function (json) {
    layer.close(pop_index);
                    var html = '';
                    $.each(json, function (i, item) {
                       // console.log("第" + i + "个元素：");
                      //  console.log(blog);
                                    html +=   '<tr>';

                                html += '<td width="70"  rowspan="2">&nbsp;</td>'

                                    html += '<td width="60" >&nbsp;</td>'

                                   html +=' <td width="660" rowspan="2" valign="bottom" ><div  align="left" class="Link_cf" style="width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><a href="/NewsPage/Details/'+item.Id+'" target="_blank"/>'+item.Title + '</div></td>';

                                         html +='<td width="180" rowspan="2" valign="bottom"><div align="right" class="Link_cf" style="width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">'+ item.CreateTime + '</div></td>';
                                              html += '</tr>';
                                               html +=' <tr>';

      html +='<td height="15"><img src="/pic/image (16).png"></td>';

      html +='</tr>';
      html +='<tr>';
      html +='<td height="5" colspan="4"><hr align="right" width="970" class="new5"/></td>';
      html +='</tr>';
                    })

                    $('#tbody').html(html);

                }, 'json');
            })


        }

        /*拼接条件返回postdata*/
        function getcond() {

            var key = document.getElementById("box").value;
            var start = null;
            var end = null;
            var cabh = "Caname";
             var order = $('#order').val();
            var ordertype = $('#ordertype').val();
            var postdata = { key: key, start: start, end: end, cabh: cabh, order: order, ordertype: ordertype };
            return postdata;
        }

        /*查询*/
        function search() {

            layui.use(['laypage', 'layer'], function () {
                var laypage = layui.laypage, layer = layui.layer, $ = layui.jquery;

                var postdata = getcond();

                var url = "/News/GetTotalCount?t=" + new Date().valueOf();
                $.post(url,postdata, function (count) {

                    var pagecount = (count % pagesize == 0 ? count / pagesize : Math.ceil(count / pagesize)); //总页数
                   // console.log("总记录数：" + count + "，总页数：" + pagecount);
                    $('#totalcount').text(count);
                    $('#pagecount').text(pagecount);
                     $('#pagesize').text(pagesize);
                      $('#space').text(txt);
                    laypage.render({
                        elem: 'pages',
                        count: count, //得到总页数
            limit: pagesize,
                        jump: function (obj) {
                            var pageindex = obj.curr;
                            //layer.alert("点击了第" + pageindex + "页。");
                            //读取后台数据数据返回JSON后拼接HTML
                            load_blog_data(pageindex);
                        }
                    });

                });

            });

        }


</script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script> 